# ureport-agent configuration
# Copy to ureport-agent.yml and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────
ureport_url: http://localhost:4100
agent_token: PASTE_YOUR_TOKEN_HERE

# Root workspace — agent stores per-lane repos here:
#   {repo_path}/myapp__e2e/        ← cloned for myapp/e2e lane
#   {repo_path}/myapp__regression/
repo_path: /tmp/ureport-agent-workspace

# ── Optional ──────────────────────────────────────────────────────────────────
# Max minutes to wait for Claude CLI to finish (default: 30)
# claude_cli_timeout_minutes: 30

# Max minutes to wait for Gemini CLI to finish (default: 30)
# gemini_cli_timeout_minutes: 30

# ── Environment variables ──────────────────────────────────────────────────────
# Set whichever key your playbooks use — not needed if you don't use that provider:
#   GEMINI_API_KEY=your-key   — required for gemini-cli provider
#
# claude-cli authenticates via browser OAuth (run `claude` once to log in).
# No API key needed for claude-cli.
#
# Git must be configured with credentials that can clone the repo in each playbook.
# All other secrets (PR API token, etc.) are configured per-playbook in the UI.
